rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function approved() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.enabled == true;
    }
    match /members/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /noticeArchive/{id} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.keys().hasAll(['title', 'weekDate', 'content', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasOnly(['title', 'weekDate', 'content', 'createdBy', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.weekDate is string
        && request.resource.data.weekDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.content is string && request.resource.data.content.size() <= 100000
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      // Published snapshots are immutable. Administrators can remove records in the console.
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
